<!DOCTYPE html>
<!-- _layout.cshtml -->
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
@await Html.PartialAsync("partials/_head.cshtml")
<body class="relative flex flex-col bg-zinc-200 dark:bg-slate-800 text-zinc-800 dark:text-zinc-100">
  <div class="bu-page flex flex-col flex-grow mx-auto">
    @await Html.PartialAsync("partials/_header.cshtml")
    <!-- Main  -->
    <div class="bu-layout">
      <div id="sidebar-backdrop" class="bu-sidebar-backdrop" onclick="toggleSidebar()"></div>
      <div id="sidebar-container" class="bu-sidebar">
        @await Html.PartialAsync("partials/_sidebar.cshtml")
      </div>
      <div class="bu-content">
        @await Html.PartialAsync("partials/_main-header.cshtml")
        @await Html.PartialAsync("partials/_before-document-body.cshtml")

        <main class="my-4 prose max-w-none prose-h1:mb-1 prose-h2:mb-1 prose-h3:mb-1 prose-h4:mb-1 prose-h5:mb-1 prose-h6:mb-1 bg-zinc-200 dark:bg-slate-800 dark:prose-invert">
          @RenderBody()
        </main>

        <!-- Main Footer -->
        @* @Html.Partial("partials/_main-footer.cshtml") *@
      </div>
    </div>
    <button type="button" class="bu-menu-button" aria-label="Open navigation menu" aria-controls="sidebar-container" onclick="toggleSidebar()">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:1.75rem;height:1.75rem">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
    <script>
      function toggleSidebar() {
        document.getElementById('sidebar-container').classList.toggle('open');
        document.getElementById('sidebar-backdrop').classList.toggle('open');
      }
      // Close drawer when a sidebar link is followed
      document.addEventListener('click', function (e) {
        if (e.target.closest('#sidebar-container a')) {
          document.getElementById('sidebar-container').classList.remove('open');
          document.getElementById('sidebar-backdrop').classList.remove('open');
        }
      });
    </script>
    @await Html.PartialAsync("partials/_scripts.cshtml")
  </div>
  @await Html.PartialAsync("partials/_search-model.cshtml")
</body>
</html>
